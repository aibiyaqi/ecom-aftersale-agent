# ===== Dify 应用配置 =====
# advanced-chat 应用用 /v1/chat-messages；工作流应用用 /v1/workflows/run
# 注意：DIFY_APP_MODE 与 DIFY_API_URL 必须一致，不一致会启动告警并自动纠正
DIFY_APP_MODE=chat
DIFY_API_URL=https://api.dify.ai/v1/chat-messages
DIFY_API_KEY=app-请替换为你的Dify应用密钥
DIFY_TIMEOUT=60
DIFY_MAX_RETRIES=1

# ===== 鉴权令牌（必改）=====
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(24))"
# 管理后台页面/接口：请求头 X-Admin-Token
ADMIN_TOKEN=请替换为管理端令牌
# Dify HTTP 节点回调：请求头 X-Service-Token
SERVICE_TOKEN=请替换为服务端令牌

# ===== 运行配置 =====
APP_ENV=development
LOG_LEVEL=INFO
# 允许的来源，逗号分隔；生产不要用 *
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# 单 IP 每分钟消息上限（单实例内存实现）
RATE_LIMIT_PER_MINUTE=30
MAX_USER_TEXT_LENGTH=1000
# 单次请求体上限（字节），在读取阶段拦截，防止大包打爆内存
MAX_REQUEST_BYTES=65536

# ===== 数据库 =====
# 默认 ecom_backend/orders.db；切 MySQL 改这里并安装 PyMySQL
# DATABASE_URL=mysql+pymysql://ecom:<MYSQL_PASSWORD>@127.0.0.1:3306/ecom?charset=utf8mb4
# DATABASE_URL=sqlite:////data/orders.db

# 仅 docker compose --profile mysql 需要（缺失会拒绝启动）
# MYSQL_ROOT_PASSWORD=
# MYSQL_PASSWORD=

# 仅本地调试可设为 true（跳过 Token 校验），生产必须为 false
ALLOW_INSECURE_NO_TOKEN=false
